# --- Required for production ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com
DATABASE_URL=postgres://user:pass@host:5432/dbname   # Neon / Supabase / Vercel Postgres
# DATABASE_SSL=disable                                # only for a local, non-TLS Postgres
ADMIN_EMAIL=you@example.com                           # first-login bootstrap (owner account)
ADMIN_PASSWORD=                                       # 12+ chars; ignored once an owner exists
ANALYTICS_SALT=                                       # long random string
CRON_SECRET=                                          # long random string; Vercel sends it to the cron route

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="RivalArcade <news@your-domain.com>"       # verified Resend domain
EMAIL_REPLY_TO=
NOTIFY_EMAIL=                                         # where new form submissions are announced
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Optional ---
NEXT_PUBLIC_GA_ID=                                    # GA4, loads only after cookie consent
GOOGLE_SITE_VERIFICATION=                             # Search Console
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                       # Cloudflare Turnstile (extra spam protection)
TURNSTILE_SECRET_KEY=
